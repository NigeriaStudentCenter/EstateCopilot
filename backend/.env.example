# Copy this to .env. With MOCK_MODE=true the server boots and every route
# responds with realistic canned data — no Postgres instance or third-party
# API keys required. Flip MOCK_MODE=false and fill in real keys per pillar
# when you're ready to go live with a given integration.

PORT=4000
MOCK_MODE=true

# --- Database (Pillar B/D persistence) ---
# Postgres connection string, e.g. from Supabase/Neon/Railway free tier.
DATABASE_URL="postgresql://user:password@localhost:5432/estatecopilot"

# --- Pillar A: Tenant Vetting & Risk Guardrails ---
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
MONO_SECRET_KEY=

# --- Pillar B: Revenue Engine (rent, deposits) ---
# Rent is never split — each landlord connects their own bank account as a
# Paystack Subaccount (from the portal's Settings page), and every tenant
# payment settles directly there. The platform only earns via the flat
# monthly subscription below, so there's no payout-split config here.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# --- WhatsApp Webhook Engine (Meta Cloud API) ---
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=change-me-verify-token
META_APP_SECRET=
# Meta Graph API version for outbound sends (default v23.0).
WA_GRAPH_VERSION=v23.0

# --- WhatsApp Marketing AI Agent (EstateCopilot + AI Academy) ---
# Off by default: the inbound webhook keeps its existing tenant/guarantor-ops
# behaviour. Set to true to route inbound messages through the brand-aware
# agent (needs ANTHROPIC_API_KEY). Works in MOCK_MODE with no DB — test via
# POST /webhooks/whatsapp/simulate {"from","text","brand"}.
WA_AGENT_ENABLED=false
WA_AGENT_MODEL=claude-haiku-4-5-20251001
WA_AGENT_MODEL_COMPLEX=claude-sonnet-5
# Where an AI Academy enrolment enquiry is sent to start onboarding
# (the "AI Academy on Wheels — Enrolment" Microsoft Form).
AI_ACADEMY_ONBOARDING_URL=https://forms.cloud.microsoft/Pages/ResponsePage.aspx?id=iBFpdp2b7ke7Wir-xS9NXguXesy5xKlEksmVVecOy5ZUM1hIVTU0OEROMFBRVFZFOVZITk5YUFJOMS4u

# --- AI Academy on Wheels enrolment (university / professional) ---
# Path A (no premium connector): the Form's Power Automate flow uses
# SharePoint "Create item" to add a row to the AI Academy Enrolments list;
# set AI_ACADEMY_ENROL_POLL=true and the backend polls that list and
# provisions each learner (create account, licence, Team, welcome email).
# Path B: POST /api/ai-academy/enrol with AI_ACADEMY_ENROL_SECRET (needs the
# premium HTTP action). Graph auth falls back to the SHAREPOINT_* app (same
# bsoed tenant) unless AI_ACADEMY_GRAPH_* is set.
AI_ACADEMY_ENROL_POLL=false
AI_ACADEMY_ENROL_POLL_MS=120000
AI_ACADEMY_ENROL_SECRET=
AI_ACADEMY_ACCOUNT_DOMAIN=bsoedu.org
AI_ACADEMY_SITE_PATH=bsoed.sharepoint.com:/sites/AIAcademy
AI_ACADEMY_ENROL_LIST_NAME=AI Academy Enrolments
AI_ACADEMY_ENROL_LIST_ID=
AI_ACADEMY_TEAM_GROUP_ID=
AI_ACADEMY_LICENSE_SKU_ID=
AI_ACADEMY_WELCOME_FROM=john@bsoedu.org
AI_ACADEMY_GRAPH_TENANT_ID=
AI_ACADEMY_GRAPH_CLIENT_ID=
AI_ACADEMY_GRAPH_CLIENT_SECRET=
# Base URL the landlord-onboarding step images/video are served from
# (the marketing site's /guides/images and /videos). Default estatecopilot.org.
WA_ONBOARDING_MEDIA_BASE=https://estatecopilot.org
# Campaign sender: messages per minute, and the minimum days between
# campaign (template) messages to the same contact.
WA_CAMPAIGN_THROTTLE_PER_MIN=60
WA_CAMPAIGN_MIN_GAP_DAYS=7
# How often the in-process scheduler checks for due SCHEDULED campaigns
# (only runs when WA_AGENT_ENABLED=true). Default 60000ms.
WA_SCHEDULER_INTERVAL_MS=60000

# --- WhatsApp Webhook Engine (Twilio alternative) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- Tenant portal auth ---
# Signs tenant login JWTs. Any random string works for a pilot; rotate it
# for production (rotating invalidates all logged-in tenant sessions).
TENANT_JWT_SECRET=change-me-to-a-long-random-string

# --- AI reply drafting (correspondence copilot) ---
# Without this, drafts are generated from templates (still fully functional
# for a demo). With it, drafts are written by Claude in the landlord's voice.
ANTHROPIC_API_KEY=
LANDLORD_DISPLAY_NAME=Aliko Hassan

# --- Public site notifications (property viewings, handyman bookings/quotes) ---
# Where "someone booked a viewing" / "a handyman quoted a job" alerts go.
OPS_WHATSAPP_NUMBER=2348000000000
OPS_EMAIL=ops@estatecopilot.example
# Email delivery. Only "resend" is wired. Unset provider/key => log-only.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=EstateCopilot <ops@estatecopilot.org>

# --- Landlord portal auth + ₦10,000/month subscription ---
# Signs landlord login JWTs. Any random string works for a pilot.
LANDLORD_JWT_SECRET=change-me-to-a-long-random-string
LANDLORD_SUBSCRIPTION_AMOUNT_KOBO=1000000
# Requires BOTH a Paystack secret key and a pre-created Plan (₦10,000/month,
# from your Paystack dashboard -> Payments -> Plans) to actually go live —
# without the plan code, signup stays in mock mode even with a real key.
PAYSTACK_LANDLORD_PLAN_CODE=
MARKETING_SIGNUP_CALLBACK_URL=http://localhost:5175/signup/callback
# Pilot billing path: signup sends landlords to this Paystack-hosted page,
# then an operator calls POST /api/landlord-auth/admin/activate to switch
# the account to ACTIVE. No secret key / Plan code needed for this path.
PAYSTACK_HOSTED_PAGE_URL=https://paystack.shop/pay/estatecopilot
# Shared key guarding POST/GET /api/landlord-auth/admin/*. Unset => the
# admin endpoints return 404 (feature disabled).
ADMIN_API_KEY=
