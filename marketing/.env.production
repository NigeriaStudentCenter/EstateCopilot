VITE_API_BASE_URL=https://estatecopilot-api.azurewebsites.net
VITE_LANDLORD_PORTAL_URL=https://landlord.estatecopilot.org
VITE_TENANT_PORTAL_URL=https://tenant.estatecopilot.org
VITE_ARTISAN_PORTAL_URL=https://artisans.estatecopilot.org
# The property marketplace's own subdomain — same build as this site, deployed
# a second time (deploy-properties.yml) to a separate Static Web App, since
# this site's Free-tier SWA is already at its 2-custom-domain limit. Opens
# straight into /properties (see isPropertiesHost() in src/lib/links.ts).
VITE_PROPERTIES_MARKETPLACE_URL=https://properties.estatecopilot.org
# Kolo partner app (referral programme). Swap to app.kolo.ng / partners-app.estatecopilot.org once that CNAME is live.
VITE_PARTNER_PORTAL_URL=https://red-ocean-01cfc2f03.3.azurestaticapps.net
# Homepage walkthrough video — YouTube/Vimeo watch URL or a direct .mp4.
# Leave blank until the video exists; the section shows a "coming soon" card.
# Self-hosted for now (YouTube embedding was unreliable on the Unlisted/Public
# video) — swap back to a youtu.be URL any time once that's sorted.
VITE_WALKTHROUGH_VIDEO_URL=/videos/walkthrough.mp4
