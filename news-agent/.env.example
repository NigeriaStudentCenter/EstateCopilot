# Microsoft Graph — app-only. Use the app registration the onboarding flow uses
# (e7494643-582b-4817-995e-8a02ebab786e). It needs Sites.ReadWrite.All (admin consented).
# ROTATE the secret first — the current one was exposed in a flow export.
GRAPH_TENANT_ID=76691188-9b9d-47ee-bb5a-2afec52f4d5e
GRAPH_CLIENT_ID=e7494643-582b-4817-995e-8a02ebab786e
GRAPH_CLIENT_SECRET=__put_a_freshly_rotated_secret_here__

# Anthropic — a dedicated key for this agent (separate from the student-tools proxy
# and deck2video, so usage is attributable and it can be revoked on its own).
ANTHROPIC_API_KEY=sk-ant-...

# Optional tuning
NEWS_AGENT_MODEL=claude-haiku-4-5
MAX_ITEMS_PER_SOURCE=12
MAX_ARTICLE_AGE_DAYS=4
MIN_RELEVANCE=60
# When a publisher blocks the scraper (Cloudflare 403), fall back to the
# r.jina.ai reader proxy. Set to 0 to stay direct-only (no third-party).
READER_FALLBACK=1

# Fact-check agent (fact_agent/) — reuses GRAPH_* and ANTHROPIC_API_KEY above.
FACT_AGENT_MODEL=claude-sonnet-4-6
FACT_MIN_CONFIDENCE=50
FACT_WEB_SEARCH_MAX_USES=5
FACT_AGENT_CRON=0 */15 * * * *
