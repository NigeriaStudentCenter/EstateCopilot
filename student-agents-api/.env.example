# Copy to .env for local dev. In Azure these are App Service application settings.

# The ONLY secret. Never commit a real value. In Azure, set this as an app
# setting (or a Key Vault reference) — not in any file that ships.
ANTHROPIC_API_KEY=

# Comma-separated list of allowed browser origins (the students page).
CORS_ORIGIN=http://localhost:5176,https://news.nigeriastudentambassador.com

# Port the server listens on. Azure App Service injects its own PORT.
PORT=4002

# Per-IP cap. A client that exceeds this in a rolling hour gets 429s.
RATE_LIMIT_PER_HOUR=8

# Model routing. "smart" = the Study Companion (careful, non-hallucinated
# academic help). "fast" = the four finders (scholarships/jobs/gigs/housing).
# Exact model id strings — no date suffix.
MODEL_SMART=claude-sonnet-4-6
MODEL_FAST=claude-haiku-4-5

# Output ceilings per tier.
MAX_TOKENS_SMART=4000
MAX_TOKENS_FAST=2000

# Which provider module handles requests. Only "anthropic" exists today;
# this is the seam a future "gemini" module plugs into without touching
# the rest of the server.
PROVIDER=anthropic
